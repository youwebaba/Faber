{
  "name": "faber",
  "productName": "Faber",
  "description": "Faber b1.2rc local AI desktop workspace",
  "version": "1.2.0-rc.1",
  "private": true,
  "type": "module",
  "main": "desktop/bootstrap.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "smoke": "electron . --smoke",
    "smoke:live": "electron . --smoke-live",
    "smoke:models": "electron . --smoke-models",
    "smoke:features": "electron . --smoke-features",
    "smoke:b12": "electron . --smoke-b12",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "build:dir": "electron-builder --win --x64 --dir --publish never",
    "build:installer": "electron-builder --win nsis --x64 --publish never",
    "prepare:lightpanda": "node scripts/prepare-lightpanda.mjs",
    "prepare:addons": "node scripts/prepare-bundled-addons.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ai.clocal.faber",
    "productName": "Faber",
    "buildVersion": "1.2.0.1",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "core/**",
      "tools/**",
      "extensions/**",
      "model-hub/**",
      "local-models/**",
      "renderer/**",
      "test/**",
      "build/**",
      "scripts/**",
      "*.md",
      "package.json",
      "package-lock.json",
      "!**/node_modules/**",
      "bundled-addons/**"
    ],
    "extraResources": [
      {
        "from": ".runtime/local-runtime",
        "to": "local-runtime"
      },
      {
        "from": ".runtime/lightpanda",
        "to": "lightpanda"
      }
    ],
    "npmRebuild": false,
    "beforePack": "build/verify-runtime.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Faber",
      "icon": "build/faber.ico",
      "artifactName": "Faber-Setup-b1.2rc-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "license": "build/licenses/THIRD-PARTY-NOTICES.txt"
    }
  }
}
