{
  "name": "faber",
  "productName": "Faber",
  "description": "Faber Alpha 2.0 desktop AI workspace",
  "version": "2.0.2-alpha.1",
  "private": true,
  "type": "module",
  "main": "desktop/bootstrap.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "smoke": "electron . --smoke",
    "smoke:live": "electron . --smoke-live",
    "smoke:models": "electron . --smoke-models",
    "smoke:features": "electron . --smoke-features",
    "smoke:b12": "electron . --smoke-b12",
    "smoke:b201": "electron . --smoke-b201",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "prepare:native": "node scripts/prepare-native.mjs",
    "build:dir": "electron-builder --win --x64 --dir --publish never",
    "build:installer": "electron-builder --win nsis --x64 --publish never",
    "prepare:lightpanda": "node scripts/prepare-lightpanda.mjs",
    "prepare:addons": "node scripts/prepare-bundled-addons.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "privacy:check:release": "node scripts/privacy-check.mjs --release"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "marked": "18.1.3"
  },
  "build": {
    "appId": "ai.clocal.faber",
    "productName": "Faber",
    "buildVersion": "2.0.2.0",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "core/**",
      "tools/**",
      "extensions/**",
      "model-hub/**",
      "local-models/**",
      "native/**",
      "!native/target/**",
      "!native/vendor/**",
      {
        "from": "native/vendor",
        "to": "native/vendor",
        "filter": ["**/*"]
      },
      "renderer/**",
      "test/**",
      "build/**",
      "scripts/**",
      "*.md",
      "package.json",
      "!**/node_modules/**",
      "bundled-addons/**"
    ],
    "extraResources": [
      {
        "from": ".runtime/local-runtime",
        "to": "local-runtime"
      },
      {
        "from": ".runtime/lightpanda",
        "to": "lightpanda"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": ["native/bin/**"],
    "beforePack": "build/verify-runtime.cjs",
    "afterPack": "scripts/privacy-after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Faber",
      "icon": "build/faber.ico",
      "artifactName": "Faber-Setup-Alpha-2.0-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "license": "build/licenses/THIRD-PARTY-NOTICES.txt"
    }
  }
}
