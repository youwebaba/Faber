{
  "name": "faber",
  "productName": "Faber",
  "description": "Faber desktop AI workspace",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "main": "desktop/bootstrap.cjs",
  "scripts": {
    "prepare:work-tools": "node scripts/prepare-work-tools.mjs",
    "prepare:scenes": "node scripts/prepare-scenes.mjs",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "smoke": "electron . --smoke",
    "smoke:live": "electron . --smoke-live",
    "smoke:models": "electron . --smoke-models",
    "smoke:features": "electron . --smoke-features",
    "smoke:b12": "electron . --smoke-b12",
    "smoke:b201": "electron . --smoke-b201",
    "smoke:media": "electron . --smoke-media",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "prepare:safetensors": "node scripts/prepare-safetensors.mjs",
    "prepare:music": "node scripts/prepare-music.mjs",
    "prepare:media": "node scripts/prepare-media.mjs",
    "prepare:timed-media": "node scripts/prepare-timed-media.mjs",
    "prepare:native": "node scripts/prepare-native.mjs",
    "build:dir": "electron-builder --win --x64 --dir --publish never",
    "build:installer": "electron-builder --win nsis --x64 --publish never",
    "prepare:lightpanda": "node scripts/prepare-lightpanda.mjs",
    "prepare:addons": "node scripts/prepare-bundled-addons.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "privacy:check:release": "node scripts/privacy-check.mjs --release"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@xmldom/xmldom": "0.9.12",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "marked": "18.1.3",
    "three": "0.187.0"
  },
  "build": {
    "appId": "ai.clocal.faber",
    "productName": "Faber",
    "buildVersion": "2.8.0.0",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "core/**",
      "tools/**",
      "extensions/**",
      "model-hub/**",
      "local-models/**",
      "native-safetensors/Cargo.toml",
      "native-safetensors/Cargo.lock",
      "native-safetensors/src/**",
      "local-music/**",
      "native/**",
      "!native/target/**",
      "!native/vendor/**",
      {
        "from": "native/vendor",
        "to": "native/vendor",
        "filter": [
          "**/*"
        ]
      },
      "renderer/**",
      "test/**",
      "build/**",
      "scripts/**",
      "*.md",
      "package.json",
      "!**/node_modules/**",
      "bundled-addons/**"
    ],
    "extraResources": [
      {
        "from": ".runtime/media-runtime",
        "to": "media-runtime"
      },
      {
        "from": ".runtime/local-runtime",
        "to": "local-runtime"
      },
      {
        "from": ".runtime/lightpanda",
        "to": "lightpanda"
      },
      {
        "from": ".runtime/music-runtime",
        "to": "music-runtime"
      },
      {
        "from": ".runtime/safetensors-runtime",
        "to": "safetensors-runtime"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "native/bin/**",
      "desktop/boot-launch.ps1",
      "desktop/boot-task.ps1"
    ],
    "beforePack": "build/verify-runtime.cjs",
    "afterPack": "scripts/privacy-after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Faber",
      "icon": "build/faber.ico",
      "artifactName": "Faber-Setup-a2.8-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "license": "build/licenses/THIRD-PARTY-NOTICES.txt"
    }
  }
}
